{
  "name": "relay",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest --run",
    "test:watch": "vitest",
    "test:coverage": "vitest --coverage",
    "gate": "npm run gate:types && npm run gate:lint && npm run gate:test && npm run gate:build",
    "gate:types": "tsc --noEmit",
    "gate:lint": "eslint . --max-warnings=0",
    "gate:test": "vitest --run",
    "gate:build": "next build",
    "verify:live": "npm run verify:stepup && npm run verify:multiowner && npm run verify:ui && npm run verify:reveal && npm run verify:factors && npm run verify:stamp",
    "verify:journeys": "npm run verify:delegate && npm run verify:request && npm run verify:standdown && npm run verify:stamp:journeys",
    "verify:delegate": "npx tsx --env-file=.env.local scripts/e2e-delegate.ts",
    "verify:request": "npx tsx --env-file=.env.local scripts/e2e-request.ts",
    "verify:standdown": "npx tsx --env-file=.env.local scripts/e2e-standdown.ts",
    "verify:schema": "npx tsx --env-file=.env.ro scripts/verify-schema.ts",
    "verify:funnel": "npx tsx scripts/verify-funnel.ts",
    "verify:stepup": "npx tsx --env-file=.env.local scripts/e2e-stepup.ts",
    "verify:multiowner": "npx tsx --env-file=.env.local scripts/e2e-multiowner.ts",
    "verify:ui": "npx tsx --env-file=.env.local scripts/e2e-ui.ts",
    "verify:reveal": "npx tsx --env-file=.env.local scripts/e2e-reveal.ts",
    "verify:roles": "npx tsx --env-file=.env.ro scripts/verify-roles.ts",
    "flight:snapshot": "npx tsx --env-file=.env.ro scripts/flight-snapshot.ts",
    "verify:iam": "npx tsx --env-file=.env.admin scripts/verify-iam.ts",
    "verify:kms": "npx tsx --env-file=.env.admin scripts/verify-kms.ts",
    "verify:dogfood": "npx tsx --env-file=.env.ro scripts/verify-dogfood.ts",
    "invite:cohort": "npx tsx --env-file=.env.local scripts/invite-cohort.ts",
    "verify:factors": "npx tsx --env-file=.env.local scripts/e2e-factors.ts",
    "verify:orphans": "npx tsx --env-file=.env.ro scripts/disposable-sweep.ts",
    "verify:stripe": "npx tsx scripts/verify-stripe.ts",
    "verify:stamp": "npx tsx scripts/stamp-verify-live.ts",
    "verify:stamp:journeys": "npx tsx scripts/stamp-verify-journeys.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "3.1072.0",
    "@aws-sdk/dsql-signer": "^3.1073.0",
    "@simplewebauthn/browser": "13.3.0",
    "@simplewebauthn/server": "13.3.2",
    "@vercel/analytics": "^2.0.1",
    "jose": "^6.2.8",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "openai": "6.44.0",
    "otplib": "^13.4.1",
    "pg": "8.22.0",
    "qrcode": "^1.5.4",
    "react": "^18",
    "react-dom": "^18",
    "resend": "6.14.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-iam": "^3.1111.0",
    "@types/node": "^20",
    "@types/pg": "8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitest/coverage-v8": "4.1.9",
    "axe-core": "4.12.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "fast-check": "4.8.0",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5",
    "vitest": "4.1.9",
    "yaml": "2.9.0"
  }
}
