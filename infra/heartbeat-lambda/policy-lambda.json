{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AlertStateObject",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:PutObject", "s3:DeleteObject"],
      "Resource": "arn:aws:s3:::__BUCKET__/heartbeat/*"
    },
    {
      "Sid": "ListSoAMissingStateIsNoSuchKeyNotAccessDenied",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::__BUCKET__"
    },
    { "Sid": "Alert", "Effect": "Allow", "Action": "sns:Publish", "Resource": "__TOPIC__" },
    { "Sid": "GitHubToken", "Effect": "Allow", "Action": "secretsmanager:GetSecretValue", "Resource": "__SECRET__" }
  ]
}
