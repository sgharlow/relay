# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env*.local
.env.dsql

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# Rendered demo video drafts (uploaded to YouTube, not tracked)
demo-out/*.mp4
# AWS console screenshots (uploaded to Devpost gallery, not tracked — contain account ID / personal email)
demo-out/*.jpg
demo-out/*.jpeg

# Scratch probe scripts. These are throwaway files written at the repo root to
# exercise live behaviour; one of them once carried a TOTP secret into a commit.
_*.ts

# Throwaway QA fixtures. They label themselves "not committed" and three of
# them still reached the repo, because `git add -A` plus a `git checkout -- .`
# that restored deletions is enough to defeat any convention.
scripts/scratch-*.ts

# Design reference renders at the repo root (relay1.png … relay4.png). Source
# material for the visual system in public/assets, kept locally and deliberately
# never committed: 19 MB of AI renders in a PUBLIC repo, to produce a set of
# SVGs that together weigh 49 KB. Anchored to the root so a legitimately-needed
# relay*.png under public/ or docs/ still tracks normally.
/relay[0-9]*.png
